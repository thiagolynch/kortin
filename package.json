{
  "name": "kortin",
  "productName": "Kortin",
  "version": "0.2.0",
  "description": "Editor de vídeo sem anúncios e sem marca d'água, com IA. Módulo 1: editor base.",
  "main": "electron/main.js",
  "author": "Thiago Lynch",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "postinstall": "install-electron --no",
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win --publish never",
    "test:engine": "node tests/engine.test.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.kortin.app",
    "productName": "Kortin",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Kortin-Instalador-${version}.exe"
    },
    "portable": {
      "artifactName": "Kortin-Portatil-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SEU-USUARIO-GITHUB",
        "repo": "kortin"
      }
    ],
    "fileAssociations": [
      {
        "ext": "kortin",
        "name": "Projeto Kortin",
        "description": "Projeto do Kortin",
        "role": "Editor"
      }
    ]
  }
}
