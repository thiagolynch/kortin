{
  "name": "kortin",
  "productName": "Kortin",
  "version": "0.7.10",
  "description": "Editor de vídeo sem marca d'água, com legenda automática, cortes sugeridos e música com abaixamento — tudo com IA local.",
  "main": "electron/main.js",
  "author": "Thiago Lynch",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "postinstall": "install-electron --no",
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "notices": "node scripts/build-notices.mjs",
    "dist": "node scripts/build-notices.mjs && vite build && electron-builder --win --publish never",
    "test:unit": "vitest run tests/unit",
    "test:engine": "node tests/engine.test.js",
    "test": "vitest run tests/unit && node tests/engine.test.js",
    "setup:whisper": "node scripts/build-whisper.mjs",
    "test:whisper": "node scripts/test-whisper.mjs",
    "verify:models": "node scripts/verify-models.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "fast-check": "^4.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.kortin.app",
    "productName": "Kortin",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**",
      "assets/fonts/**",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "assets/fonts/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Kortin-Instalador-${version}.exe"
    },
    "portable": {
      "artifactName": "Kortin-Portatil-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thiagolynch",
        "repo": "kortin"
      }
    ],
    "fileAssociations": [
      {
        "ext": "kortin",
        "name": "Projeto Kortin",
        "description": "Editor de vídeo sem marca d'água, com legenda automática, cortes sugeridos e música com abaixamento — tudo com IA local.",
        "role": "Editor"
      }
    ],
    "extraResources": [
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "vendor/whisper/${os}",
        "to": "whisper",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
